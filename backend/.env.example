# SMTP settings — fill these in to send real email.
# If SMTP_HOST is left blank, submissions are logged to the console instead
# (useful for local development).

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# true = STARTTLS on port 587 ; false = implicit SSL on port 465
SMTP_USE_TLS=true

# Envelope addresses
MAIL_FROM=no-reply@leadsinthepipe.com
MAIL_TO=umair@leadsinthepipe.com

# Comma-separated list of allowed browser origins (your site)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://leadsinthepipe.com,https://www.leadsinthepipe.com
