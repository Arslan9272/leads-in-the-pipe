# Email backend base URL. When set, forms POST here:
#   audit form -> ${VITE_API_BASE_URL}/api/audit
#   hero form  -> ${VITE_API_BASE_URL}/api/lead
#
# Local dev: point at the local FastAPI server (backend/main.py on :8010).
# Production (Vercel single project): set this to "/" so the forms hit the
#   bundled serverless function same-origin (-> /api/audit, /api/lead).
VITE_API_BASE_URL=http://localhost:8010

# Optional Formspree fallback (used only when VITE_API_BASE_URL is empty)
VITE_FORMSPREE_ENDPOINT=

VITE_CONTACT_EMAIL=umair@leadsinthepipe.com
